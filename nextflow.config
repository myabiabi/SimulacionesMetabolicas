workDir = '/mnt/data/sur/users/mmontante/02_resultados/nf_work'


executor {
    queueSize = 5
    submitRateLimit = '10/1min'
}


report {
    enabled = true
    file    = '/mnt/data/sur/users/mmontante/02_resultados/nf_work/nf_logs/nextflow_report.html'
    overwrite = true
}

trace {
    enabled = true
    file    = '/mnt/data/sur/users/mmontante/02_resultados/nf_work/nf_logs/nextflow_trace.txt'
    overwrite = true
}




params {
    genomes        = '/mnt/data/sur/users/mmontante/02_resultados/models_core/*faa'
    memote_input   = '/mnt/data/sur/users/mmontante/02_resultados/cc/models/cc_pk_gp_lb*.xml'
    comets_script  = '/mnt/data/sur/users/mmontante/SimulacionesMetabolicas/sim_syncom_comets.py'
    gem_path       = '/mnt/data/sur/users/mmontante/02_resultados/cc/models/final_models'
    com_path      = '/mnt/data/sur/users/mmontante/01_data/rz/syncoms.csv'
    outbase        = '/mnt/data/sur/users/mmontante/02_resultados/2509_resultados'
    fill_outdir    = '/mnt/data/sur/users/mmontante/02_resultados'
    fill_input     = '/mnt/data/sur/users/mmontante/02_resultados/rz/gapseq_raw'
    fill_media     = '/mnt/data/sur/users/mmontante/01_data/media/LBmed.csv' 
    media          = 'lb2'
    mass	   = '5e-6'
    cycles         = 1000
    media_dil      = 1
    media_vol      = 0.03
    output_dir     = '/mnt/data/sur/users/mmontante/02_resultados/cc/memote'
    gapseq_indir   = '/mnt/data/sur/users/mmontante/02_resultados/rz/gapseq/gapfind'
    gapseq_outdir  = '/mnt/data/sur/users/mmontante/02_resultados'
    gapseq_media   = '/mnt/data/sur/users/mmontante/01_data/media/LBmed.csv'
   
    
}


executor {
    queueStatInterval = '5 min'
    pollInterval       = '1 min'
    submitRateLimit    = '10/1min'
}

profiles {
    memote {
        process.executor = 'slurm'

        withName: 'MEMOTE_REPORT' {
            cpus   = 8
            memory = '8 GB'
            time   = '240h'
        }

        withName: 'COMPARE_MEMOTE' {
            cpus   = 2
            memory = '4 GB'
            time   = '1h'
        }
    }


    comets {
        process.executor = 'slurm'
        process.memory     = '100 GB'
        process.cpus      = 4
        params.outbase    = '/mnt/data/sur/users/mmontante/02_resultados/2509_resultados'
    }

     combos {
        process.executor = 'slurm'
        process.cpus      = 2
	process.memory    = '40 GB'
        process.time      = '48h'
	process.errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        process.maxRetries    = 3
        params.outbase    = '/mnt/data/sur/users/mmontante/02_resultados/2209_resultados/cc/combos'

     }


     doall {
    process.executor = 'slurm'
    process.cpus      = 4
    process.memory    = '16 GB'
    process.time      = '24h'
}
    gapseq {
    process.executor = 'slurm'
    process.cpus      = 4
    process.memory    = '40 GB'
    process.time      = '24h'
}

fill {
        process.executor = 'slurm'
        process.cpus      = 4
        process.memory    = '16 GB'
        process.time      = '24h'
    }
   
}
