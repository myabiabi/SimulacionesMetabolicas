/*
 * ==========================================================================
 * nextflow.config
 *
 * Configuracion para correr main.nf en el cluster con SLURM.
 * AJUSTA: partition, cpus, memory, time segun tu cluster.
 * ==========================================================================
 */

profiles {

    slurm {
        process {
            executor     = 'slurm'
            queue        = 'normal'      // <-- ajusta a la particion real (ver `sinfo`)
            cpus         = 4
            memory       = '16 GB'
            time         = '12h'
        }

        // Numero maximo de tareas corriendo al mismo tiempo (equivalente
        // al "%M" que usabamos en --array=0-N%M de SLURM)
        executor {
            queueSize = 3
        }
    }

    local {
        process {
            executor = 'local'
            cpus     = 2
            memory   = '4 GB'
        }
    }
}

// Log de ejecucion: guarda un reporte con tiempos, cpu/mem usados, etc.
report {
    enabled   = true
    file      = "nextflow_report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "nextflow_trace.txt"
    overwrite = true
}
