library(dplyr)
library(readr)
med_path <- "/home/abigaylmontantearenas/Documents/proyecto_tesis/01_data/media/medium_pred"
archivos <- list.files(med_path, pattern = "*.csv", full.names = TRUE)
lista_nombres <- lapply(archivos, function(archivo) {
df <- read_csv(archivo, show_col_types = FALSE)
nombre_cepa <- tools::file_path_sans_ext(basename(archivo))
df %>% select(name) %>%
mutate(presencia = 1) %>%
rename(!!nombre_cepa := presencia)
})
