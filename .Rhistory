library(dplyr)
library(ggplot2)
library(stringr)
# 1. Cargar datos
data <- read.csv("/home/abigaylmontantearenas/Documents/proyecto_tesis/02_resultados/121026/cc_velocity_table.csv")
# 2. Procesar datos y filtrar solo las velocidades mayores a 0
data_filtered <- data %>%
mutate(
ID = str_extract(simulation, "[A-Z][a-zA-Z0-9_]+(?=_biomass|$)") %>%
gsub("_biomass$", "", .),
Condition = str_extract(simulation, "^.*?(?=[A-Z])") %>%
gsub("_$", "", .)
) %>%
filter(velocity > 0) # Filtra las filas donde velocity no es 0
# 3. Graficar únicamente la columna de velocity con scale_y_log10
p <- ggplot(data_filtered, aes(x = ID, y = velocity, fill = Condition)) +
geom_col(position = "dodge") +
scale_y_log10() + # Aplica log10 de forma limpia sin errores por ceros
facet_wrap(~ Condition, scales = "free_x") +
theme_bw() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1, size = 8),
legend.position = "none"
) +
labs(
title = "Velocidad de Crecimiento (Solo simulaciones con crecimiento > 0)",
x = "Organismo / ID",
y = "Velocidad [log10]"
)
print(p)
# Guardar la gráfica
ggsave(
filename = "/home/abigaylmontantearenas/Documents/proyecto_tesis/02_resultados/121026/velocidad_filtrada_log.png",
plot = p,
width = 12,
height = 7,
dpi = 300
)
library(dplyr)
library(ggplot2)
library(stringr)
# 1. Cargar datos
data <- read.csv("/home/abigaylmontantearenas/Documents/proyecto_tesis/02_resultados/121026/cc_velocity_table.csv")
# 2. Procesar datos y filtrar solo las velocidades mayores a 0
data_filtered <- data %>%
mutate(
ID = str_extract(simulation, "[A-Z][a-zA-Z0-9_]+(?=_biomass|$)") %>%
gsub("_biomass$", "", .),
Condition = str_extract(simulation, "^.*?(?=[A-Z])") %>%
gsub("_$", "", .)
) %>%
filter(velocity > 0) # Filtra las filas donde velocity no es 0
# 3. Graficar la columna de velocity con PUNTOS y scale_y_log10
p <- ggplot(data_filtered, aes(x = ID, y = velocity, color = Condition)) +
