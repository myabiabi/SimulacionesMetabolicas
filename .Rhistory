library(dplyr)
library(ggplot2)
library(tidyr)
library(tools)
# -------------------------------------------------------------------
# 1. Extracción de biomasa y guardado de datos
# -------------------------------------------------------------------
mass_path <- "/home/abigaylmontantearenas/Documents/proyecto_tesis/02_resultados/121026/cc_biomasa"
output_path <- "/home/abigaylmontantearenas/Documents/proyecto_tesis/02_resultados/121026"
dir.create(output_path, showWarnings = FALSE, recursive = TRUE)
files <- list.files(mass_path, full.names = TRUE)
velocity_table <- data.frame(
simulation = character(),
initial_mass = numeric(),
final_mass = numeric(),
velocity = numeric(),
stringsAsFactors = FALSE
)
for (file in files) {
df <- read.table(file, header = TRUE)
if (nrow(df) == 0) {
warning(paste("El archivo está vacío y se omitirá:", file))
next
}
colnames(df) <- c("cycle", "x", "y", "id", "mass")
nombre <- file_path_sans_ext(basename(file))
m_init <- df$mass[1]
m_final <- tail(df$mass, 1)
velocity_general <- m_final - m_init
velocity_table <- rbind(
velocity_table,
data.frame(
simulation = nombre,
initial_mass = m_init,
final_mass = m_final,
velocity = velocity_general,
stringsAsFactors = FALSE
)
)
}
# Guardar con el nombre exacto que vas a leer después
csv_file <- file.path(output_path, "cc_velocity_table.csv")
write.csv(velocity_table, csv_file, row.names = FALSE)
# -------------------------------------------------------------------
# 2. Transformación de datos y generación de gráficas
# -------------------------------------------------------------------
data <- read.csv(csv_file)
# Extraer el 'Method' desde 'simulation' (asumiendo separador "_", ej: "Metodo1_ModeloA")
# Si el nombre tiene otro patrón, ajusta esta expresión regular
data <- data %>%
mutate(Method = sub("_.*$", "", simulation))
# Transformar a formato largo (pivot) para comparar initial_mass y final_mass en ggplot
data_long <- data %>%
pivot_longer(
cols = c(initial_mass, final_mass),
names_to = "Mass_Type",
values_to = "Mass_Value"
) %>%
group_by(Method) %>%
mutate(Model = dense_rank(simulation)) %>%
ungroup()
# Crear directorio de salida para las gráficas
plots_dir <- file.path(output_path, "graficas_metodos")
dir.create(plots_dir, showWarnings = FALSE, recursive = TRUE)
metodos <- unique(data_long$Method)
for (metodo in metodos) {
datos <- data_long %>%
filter(Method == metodo)
p <- ggplot(datos, aes(x = factor(Model), y = Mass_Value, fill = Mass_Type)) +
geom_col(position = "dodge") +
labs(
title = paste("Method:", metodo),
x = "Model",
y = "Mass (g)",
fill = "Legend"
) +
theme_classic()
print(p)
# Guardar cada gráfica con el nombre del método correspondiente dentro de la carpeta
output_image <- file.path(plots_dir, paste0("cc_velocidad_", metodo, ".png"))
ggsave(
filename = output_image,
plot = p,
width = 18,
height = 7,
units = "in",
dpi = 600
)
}
library(dplyr)
library(ggplot2)
library(tidyr)
library(stringr)
# 1. Cargar datos
data <- read.csv("/home/abigaylmontantearenas/Documents/proyecto_tesis/02_resultados/121026/cc_velocity_table.csv")
# 2. Extraer el ID de la bacteria y la Condición/Método desde 'simulation'
data_clean <- data %>%
mutate(
# Extrae desde la primera letra mayúscula hasta antes de '_biomass'
ID = str_extract(simulation, "[A-Z][a-zA-Z0-9_]+(?=_biomass|$)") %>%
gsub("_biomass$", "", .),
# Extrae el prefijo previo al nombre del organismo como Condicion
Condition = str_extract(simulation, "^.*?(?=[A-Z])") %>%
gsub("_$", "", .)
)
# 3. Transformar a formato largo para graficar masa inicial vs final
data_long <- data_clean %>%
pivot_longer(
cols = c(initial_mass, final_mass),
names_to = "Mass_Type",
values_to = "Mass_Value"
)
# 4. Graficar por ID (comprando condiciones o masa)
p <- ggplot(data_long, aes(x = ID, y = Mass_Value, fill = Mass_Type)) +
geom_col(position = "dodge") +
facet_wrap(~ Condition, scales = "free_y") +
theme_bw() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1, size = 9),
strip.background = element_rect(fill = "lightgray")
) +
labs(
title = "Comparación de Biomasa por ID de Microorganismo",
x = "Organismo / ID",
y = "Masa (g)",
fill = "Tipo de Masa"
)
print(p)
# Guardar la gráfica
ggsave(
filename = "/home/abigaylmontantearenas/Documents/proyecto_tesis/02_resultados/121026/biomasa_por_id.png",
plot = p,
width = 14,
height = 8,
dpi = 300
)
