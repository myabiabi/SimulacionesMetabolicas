)
library(dplyr)
library(ggplot2)
library(stringr)
library(scales) # Requerido para pseudo_log_trans
# 1. Cargar datos
data <- read.csv("/home/abigaylmontantearenas/Documents/proyecto_tesis/02_resultados/121026/cc_velocity_table.csv")
# 2. Procesar datos (sin filtrar los ceros)
data_clean <- data %>%
mutate(
ID = str_extract(simulation, "[A-Z][a-zA-Z0-9_]+(?=_biomass|$)") %>%
gsub("_biomass$", "", .),
Condition = str_extract(simulation, "^.*?(?=[A-Z])") %>%
gsub("_$", "", .)
)
# 3. Graficar TODOS los puntos (incluyendo 0) con escala pseudo-log
p <- ggplot(data_clean, aes(x = ID, y = velocity, color = Condition)) +
geom_point(size = 3, alpha = 0.7) +
# pseudo_log_trans permite graficar 0 y valores muy pequeños (1e-14) en la misma escala
scale_y_continuous(trans = pseudo_log_trans(base = 10)) +
facet_wrap(~ Condition) +
theme_bw() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1, size = 8),
legend.position = "none"
) +
labs(
title = "Velocidad de Crecimiento por ID (Todas las simulaciones)",
x = "Organismo / ID",
y = "Velocidad [pseudo-log10]"
)
print(p)
# Guardar la gráfica
ggsave(
filename = "/home/abigaylmontantearenas/Documents/proyecto_tesis/02_resultados/121026/velocidad_todas_puntos.png",
plot = p,
width = 12,
height = 7,
dpi = 300
)
library(dplyr)
library(ggplot2)
library(stringr)
library(scales) # Requerido para pseudo_log_trans
# 1. Cargar datos
data <- read.csv("/home/abigaylmontantearenas/Documents/proyecto_tesis/02_resultados/121026/cc_velocity_table.csv")
# 2. Procesar datos y agregar etiqueta para los valores igual a 0
data_clean <- data %>%
mutate(
ID = str_extract(simulation, "[A-Z][a-zA-Z0-9_]+(?=_biomass|$)") %>%
gsub("_biomass$", "", .),
Condition = str_extract(simulation, "^.*?(?=[A-Z])") %>%
gsub("_$", "", .),
# Marca si la velocidad es exactamente 0
Color_Group = if_else(velocity == 0, "Cero (Sin crecimiento)", Condition)
)
# 3. Definir paleta de colores personalizada (Rojo para los 0s, azul/negro/etc. para las condiciones)
# Se asigna de forma dinámica según las condiciones presentes en tus datos
condiciones <- unique(data_clean$Condition)
colores <- setNames(c("red", hue_pal()(length(condiciones))), c("Cero (Sin crecimiento)", condiciones))
# 4. Graficar
p <- ggplot(data_clean, aes(x = ID, y = velocity, color = Color_Group)) +
geom_point(size = 3, alpha = 0.8) +
scale_color_manual(values = colores) + # Aplica los colores personalizados
scale_y_continuous(trans = pseudo_log_trans(base = 10)) +
facet_wrap(~ Condition) +
theme_bw() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1, size = 8),
legend.position = "bottom" # Muestra la leyenda abajo para identificar el color rojo
) +
labs(
title = "Velocidad de Crecimiento por ID (Valores 0 en Rojo)",
x = "Organismo / ID",
y = "Velocidad [pseudo-log10]",
color = "Estado / Condición"
)
print(p)
# Guardar la gráfica
ggsave(
filename = "/home/abigaylmontantearenas/Documents/proyecto_tesis/02_resultados/121026/velocidad_puntos_rojos.png",
plot = p,
width = 12,
height = 7,
dpi = 300
)
library(dplyr)
library(ggplot2)
library(stringr)
library(scales) # Requerido para pseudo_log_trans
# 1. Cargar datos
data <- read.csv("/home/abigaylmontantearenas/Documents/proyecto_tesis/02_resultados/121026/cc_velocity_table.csv")
# 2. Procesar datos y etiquetar ceros
data_clean <- data %>%
mutate(
ID = str_extract(simulation, "[A-Z][a-zA-Z0-9_]+(?=_biomass|$)") %>%
gsub("_biomass$", "", .),
Condition = str_extract(simulation, "^.*?(?=[A-Z])") %>%
gsub("_$", "", .),
Color_Group = if_else(velocity == 0, "Cero (Sin crecimiento)", "Crecimiento (>0)")
)
# Directorio de salida para las gráficas individuales
plots_dir <- "/home/abigaylmontantearenas/Documents/proyecto_tesis/02_resultados/121026/graficas_individuales"
dir.create(plots_dir, showWarnings = FALSE, recursive = TRUE)
# Obtener lista de condiciones
condiciones <- unique(data_clean$Condition)
# 3. Generar y guardar una gráfica por cada condición
for (cond in condiciones) {
# Filtrar datos de la condición actual
df_cond <- data_clean %>% filter(Condition == cond)
p <- ggplot(df_cond, aes(x = ID, y = velocity, color = Color_Group)) +
geom_point(size = 3.5, alpha = 0.8) +
# Asignar rojo a 0 y azul/oscuro a los que sí crecieron
scale_color_manual(values = c("Cero (Sin crecimiento)" = "red", "Crecimiento (>0)" = "#2b5c8f")) +
scale_y_continuous(trans = pseudo_log_trans(base = 10)) +
theme_bw() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1, size = 9),
plot.title = element_text(face = "bold", size = 12),
legend.position = "bottom"
) +
labs(
title = paste("Velocidad de Crecimiento - Condición:", cond),
x = "Organismo / ID",
y = "Velocidad [pseudo-log10]",
color = "Estado"
)
# Imprimir en consola/RStudio
print(p)
# Guardar archivo individual
file_out <- file.path(plots_dir, paste0("velocidad_", cond, ".png"))
ggsave(
filename = file_out,
plot = p,
width = 9,
height = 6,
dpi = 300
)
}
library(dplyr)
library(ggplot2)
library(stringr)
library(scales) # Requerido para pseudo_log_trans
# 1. Cargar datos
data <- read.csv("/home/abigaylmontantearenas/Documents/proyecto_tesis/02_resultados/121026/cc_velocity_table.csv")
# 2. Procesar datos garantizando la extracción de los 18 IDs
data_clean <- data %>%
mutate(
# Elimina el sufijo _biomass (o _d_biomass, etc.)
temp_name = sub("_biomass$", "", simulation),
# Extrae la condición (todo lo que está antes del primer nombre taxonómico o patrón conocido)
# Si la estructura es simpre "prefijo_Organismo", eliminamos las primeras partes conocidas:
Condition = sub("^(cc_na_[^_]+_[^_]+_).*", "\\1", simulation) %>% sub("_$", "", .),
# Extrae el ID completo quitando la condición del inicio
ID = mapply(function(sim, cond) {
sub(paste0("^", cond, "_?"), "", sim) %>% sub("_biomass$", "", .)
}, simulation, Condition),
Color_Group = if_else(velocity == 0, "Cero (Sin crecimiento)", "Crecimiento (>0)")
)
# Verificar cuántos IDs únicos se extrajeron en la consola
print(paste("IDs únicos detectados:", length(unique(data_clean$ID))))
print(unique(data_clean$ID))
# 3. Generar gráficas individuales por condición
plots_dir <- "/home/abigaylmontantearenas/Documents/proyecto_tesis/02_resultados/121026/graficas_individuales"
dir.create(plots_dir, showWarnings = FALSE, recursive = TRUE)
condiciones <- unique(data_clean$Condition)
for (cond in condiciones) {
df_cond <- data_clean %>% filter(Condition == cond)
p <- ggplot(df_cond, aes(x = ID, y = velocity, color = Color_Group)) +
geom_point(size = 3.5, alpha = 0.8) +
scale_color_manual(values = c("Cero (Sin crecimiento)" = "red", "Crecimiento (>0)" = "#2b5c8f")) +
scale_y_continuous(trans = pseudo_log_trans(base = 10)) +
theme_bw() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1, size = 8),
plot.title = element_text(face = "bold", size = 11),
legend.position = "bottom"
) +
labs(
title = paste("Velocidad de Crecimiento - Condición:", cond),
x = "Organismo / ID",
y = "Velocidad [pseudo-log10]",
color = "Estado"
)
print(p)
ggsave(
filename = file.path(plots_dir, paste0("velocidad_", cond, ".png")),
plot = p,
width = 11,
height = 6,
dpi = 300
)
}
