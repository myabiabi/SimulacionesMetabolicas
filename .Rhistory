next
}
colnames(df) <- c("cycle", "x", "y", "id", "mass")
nombre <- tools::file_path_sans_ext(basename(file))
# Calcular masa inicial y final de forma segura
m_init <- df$mass[1]
m_final <- tail(df$mass, 1)
velocity_general <- m_final - m_init
# Guardar en la tabla
velocity_table <- rbind(
velocity_table,
data.frame(
simulation = nombre,
initial_mass = m_init,
final_mass = m_final,
velocity = velocity_general,
stringsAsFactors = FALSE
)
)
}
# Guardar el resultado final en un CSV
write.csv(velocity_table, file.path(output_path, "velocity_table.csv"), row.names = FALSE)
